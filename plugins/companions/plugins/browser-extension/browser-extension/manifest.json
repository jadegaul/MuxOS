{
  "manifest_version": 3,
  "name": "muxos",
  "description": "muxos from any tab: send a wish, jump between MuxOS.app and your own muxos, and run the actions your apps offer on the page.",
  "version": "1.0.0",
  "action": {
    "default_title": "muxos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["http://*.localhost/*"]
}
